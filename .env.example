# ─── Contact form (SMTP) ───────────────────────────────────────────────
# Required for the /ContactMe form to deliver email to your inbox.
# Until these are set, the form gracefully falls back to opening the
# visitor's mail client (mailto), so nothing breaks before configuration.
#
# Example for Gmail (use an App Password, NOT your account password):
#   1. Enable 2-Step Verification on your Google account
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Use smtp.gmail.com / 465 (or 587) with that App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
# Optional: address the form sends TO (defaults to the site contact email)
CONTACT_TO=gautams4work@gmail.com
# Optional: the visible From address (defaults to SMTP_USER)
SMTP_FROM=your-address@gmail.com

# ─── AI blog (/blog + /api/cron/generate-blog) ─────────────────────────
# MongoDB (e.g. a free MongoDB Atlas cluster) where blog posts are stored.
MONGO_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/portfolio
# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model (default gemini-3.8-flash), thinking level (low|medium|high),
# and Google Search grounding for fact-checking (default true)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=low
# GEMINI_GROUNDING=true
# Long random string. cron-job.org must send header:  Authorization: Bearer <CRON_SECRET>
# Generate one with:  openssl rand -hex 32
CRON_SECRET=
# Set to "false" to save generated posts as drafts instead of publishing them
# BLOG_AUTO_PUBLISH=true
# Minimum minutes between posts; extra triggers inside this window are skipped
# (default 100, fits a 2-hourly cron). Set 0 to disable.
# BLOG_MIN_INTERVAL_MINUTES=100

# ─── SEO / analytics ───────────────────────────────────────────────────
# Google Analytics 4 measurement ID — the tag is only added when this is set
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Google Search Console "HTML tag" verification code (content="..." value only)
# GOOGLE_SITE_VERIFICATION=

# ─── Existing auth (only if you use the NextAuth routes) ───────────────
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=
# Github_id=
# Github_Secret=
# Google_id=
# Google_Secret=
# jwt_secret=
