# ─── Contact form (SMTP) ───────────────────────────────────────────────
# Required for the /ContactMe form to deliver email to your inbox.
# Until these are set, the form gracefully falls back to opening the
# visitor's mail client (mailto), so nothing breaks before configuration.
#
# Example for Gmail (use an App Password, NOT your account password):
#   1. Enable 2-Step Verification on your Google account
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Use smtp.gmail.com / 465 (or 587) with that App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-app-password
# Optional: address the form sends TO (defaults to the site contact email)
CONTACT_TO=gautams4work@gmail.com
# Optional: the visible From address (defaults to SMTP_USER)
SMTP_FROM=your-address@gmail.com

# ─── Existing auth (only if you use the NextAuth routes) ───────────────
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=
# Github_id=
# Github_secret=
# Google_id=
# Google_secret=
# MONGO_URI=
